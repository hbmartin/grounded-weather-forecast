<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The nightly retrain: rebuild -> backtest -> report -> truth QC.
       This is what makes "improves as the archive grows" happen unattended;
       promotions land in the append-only release ledger. -->
  <key>Label</key>
  <string>com.grounded-weather-forecast.maintain</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LAUNCHER__</string>
    <string>maintain</string>
    <string>__REPO__</string>
    <string>__UV__</string>
    <string>--directory</string>
    <string>__REPO__</string>
    <string>run</string>
    <string>--locked</string>
    <string>--project</string>
    <string>__REPO__</string>
    <string>grounded-weather-forecast</string>
    <string>maintain</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SYNOPTIC_TOKEN</key>
    <string>__SYNOPTIC_TOKEN__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/maintain.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/maintain.log</string>
</dict>
</plist>
